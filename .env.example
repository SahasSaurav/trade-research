APP_NAME=trade-research
APP_ENV=development

# Model provider options: ollama, openai, xai, google-genai
# Default: ollama (local)
MODEL_PROVIDER=ollama
MODEL_NAME=gemma4:12b-mlx
MODEL_TEMPERATURE=0.7

# Ollama (local) - no API key needed
OLLAMA_BASE_URL=http://localhost:11434
# Unset = the model's own context window, which is usually larger than this
# pipeline fills and costs KV cache.
# OLLAMA_NUM_CTX=8192

# --- Search result sizing -------------------------------------------------
# Defaults reproduce the previous hardcoded values. chunksPerSource is only
# honoured at SEARCH_REFERENCE_DEPTH=advanced.
# SEARCH_REFERENCE_MAX_RESULTS=5
# SEARCH_REFERENCE_CHUNKS_PER_SOURCE=1
# SEARCH_REFERENCE_DEPTH=advanced
# SEARCH_NEWS_MAX_RESULTS=5
# SEARCH_NEWS_TIME_RANGE=day

# --- Retry budgets --------------------------------------------------------
# Each re-runs a whole agent, so they multiply cost. BUDGET_ANALYST_ATTEMPTS=2
# permits 3 full analyst runs; 0 disables repair.
# BUDGET_ANALYST_ATTEMPTS=2
# BUDGET_RESEARCH_ATTEMPTS=3

# OpenAI (ChatGPT)
OPENAI_API_KEY=

# xAI (Grok)
XAI_API_KEY=

# Google Gemini
GOOGLE_API_KEY=

# Tavily (search)
TAVILY_API_KEY=