APP_NAME=trade-research
APP_ENV=development

# Model provider options: ollama, openai, xai, google-genai
# Default: ollama (local)
MODEL_PROVIDER=ollama
MODEL_NAME=gemma4:12b-mlx
MODEL_TEMPERATURE=0.7

# Ollama (local) - no API key needed
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI (ChatGPT)
OPENAI_API_KEY=

# xAI (Grok)
XAI_API_KEY=

# Google Gemini
GOOGLE_API_KEY=

# Tavily (search)
TAVILY_API_KEY=