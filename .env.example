APP_NAME=trade-research
APP_ENV=development

# Model provider options: ollama, openai, xai, google-genai
# Default: ollama (local)
MODEL_PROVIDER=ollama
MODEL_NAME=gemma4:12b-mlx
MODEL_TEMPERATURE=0.7

# Ollama (local) - no API key needed
OLLAMA_BASE_URL=http://localhost:11434
# Unset = the model's own context window, which is usually larger than this
# pipeline fills and costs KV cache.
# OLLAMA_NUM_CTX=8192

# --- Search result sizing -------------------------------------------------
# Defaults reproduce the previous hardcoded values. chunksPerSource is only
# honoured at SEARCH_REFERENCE_DEPTH=advanced.
# SEARCH_REFERENCE_MAX_RESULTS=5
# SEARCH_REFERENCE_CHUNKS_PER_SOURCE=1
# SEARCH_REFERENCE_DEPTH=advanced
# SEARCH_NEWS_MAX_RESULTS=5
# SEARCH_NEWS_TIME_RANGE=month

# --- Retry budgets --------------------------------------------------------
# Each re-runs a whole agent, so they multiply cost. BUDGET_ANALYST_ATTEMPTS=2
# permits 3 full analyst runs; 0 disables repair.
# BUDGET_ANALYST_ATTEMPTS=2
# BUDGET_RESEARCH_ATTEMPTS=3

# --- Context compaction ---------------------------------------------------
# The financials, analyst and market agents summarise their transcript once it
# grows past this many tokens, writing the evicted messages to
# .cache/conversation-history/. deepagents' own default is 85% of a published
# window and a fixed 170k tokens when there is none, which a local model never
# reaches before it overflows: set the trigger to roughly 40% of OLLAMA_NUM_CTX.
# CONTEXT_SUMMARY_TRIGGER_TOKENS=60000
# CONTEXT_KEEP_MESSAGES=6

# --- Context store --------------------------------------------------------
# Off unless a path is set: a cache that outlives the process changes what a
# re-run sees. When on, it caches page reads (per URL, for the ttl), records
# each finished run with its artifacts, and lets a crashed run resume instead
# of re-paying every node that already finished. The image runs non-root on an
# ephemeral filesystem, so this needs a mounted volume to survive a container.
# CONTEXT_DB_PATH=.cache/context.db
# 0 keeps the run record and leaves open_url on its in-memory cache.
# CONTEXT_DB_PAGE_TTL_HOURS=12

# OpenAI (ChatGPT)
OPENAI_API_KEY=

# xAI (Grok)
XAI_API_KEY=

# Google Gemini
GOOGLE_API_KEY=

# Tavily (search)
TAVILY_API_KEY=