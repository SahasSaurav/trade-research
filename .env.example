APP_NAME=trade-research
APP_ENV=development

# Model provider options: ollama, openai, xai, google-genai
# Default: ollama (local)
MODEL_PROVIDER=ollama
MODEL_NAME=gemma4:12b-mlx
MODEL_TEMPERATURE=0.7

# Ollama (local) - no API key needed
OLLAMA_BASE_URL=http://localhost:11434
# Context window for the local model. Unset = the model's own default, which
# can be far larger than this pipeline fills and grows the KV cache. On a 12B
# MLX build this decides whether the model stays resident in unified memory.
# OLLAMA_NUM_CTX=8192

# --- Search result sizing -------------------------------------------------
# On the local provider Tavily credits are the only spend, so these are the
# cost knobs. Defaults reproduce the previous hardcoded values.
# chunksPerSource is only honoured at searchDepth=advanced.
# SEARCH_REFERENCE_MAX_RESULTS=5
# SEARCH_REFERENCE_CHUNKS_PER_SOURCE=1
# SEARCH_REFERENCE_DEPTH=advanced
# SEARCH_NEWS_MAX_RESULTS=5
# SEARCH_NEWS_TIME_RANGE=day
# Result cache lifetime. 5 minutes suits news; a longer TTL suits reference
# data, where trailing EPS barely moves in an hour.
# SEARCH_CACHE_TTL_MS=300000
# SEARCH_CACHE_MAX_ENTRIES=100

# --- Retry budgets --------------------------------------------------------
# Each of these re-runs a whole agent, so they multiply cost rather than
# adding to it. analystAttempts=2 means up to 3 full analyst runs;
# 0 disables repair and sends the first result straight to validation.
# BUDGET_ANALYST_ATTEMPTS=2
# BUDGET_RESEARCH_ATTEMPTS=3

# OpenAI (ChatGPT)
OPENAI_API_KEY=

# xAI (Grok)
XAI_API_KEY=

# Google Gemini
GOOGLE_API_KEY=

# Tavily (search)
TAVILY_API_KEY=