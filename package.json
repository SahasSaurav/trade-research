{
	"name": "trade-research",
	"version": "1.0.0",
	"description": "Multi-agent LangGraph pipeline that researches a ticker and produces a cited buy/hold/avoid decision.",
	"license": "ISC",
	"author": "",
	"type": "module",
	"main": "dist/src/index.js",
	"scripts": {
		"dev": "tsx src/index.ts",
		"dev:valuation": "tsx src/index.ts --valuation",
		"dev:analyst": "tsx src/index.ts --analyst",
		"build": "tsc",
		"lint": "biome check",
		"format": "biome format --write",
		"format:check": "biome format",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@types/node": "^26.6.2",
		"@vitest/coverage-v8": "^5.0.2",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.0.2"
	},
	"dependencies": {
		"@langchain/google": "^0.2.7",
		"@langchain/langgraph": "^1.4.17",
		"@langchain/ollama": "^1.3.0",
		"@langchain/openai": "^1.5.13",
		"@langchain/tavily": "^1.2.0",
		"dotenv": "^18.0.3",
		"langchain": "^1.5.12",
		"zod": "^4.6.5"
	}
}
