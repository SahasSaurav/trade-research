{
	"compilerOptions": {
		"target": "ES2023",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"lib": ["ES2023"],
		"paths": {
			"@src/*": ["./src/*"]
		},
		"types": ["node"],
		"outDir": "dist",
		"rootDir": ".",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"declaration": true,
		"sourceMap": true
	},
	"include": ["src", "test", "vitest.config.ts"],
	"exclude": ["dist", "node_modules"]
}
